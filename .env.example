# Google Gemini Developer API Configuration
# Replace with your actual Gemini API Key from Google AI Studio / Google Cloud
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Model Identifier (Default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Inference Hyperparameters
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=400

# Client Timeout and Retry Settings
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2

# Database & Cache Configuration
DATABASE_PATH=database/iimbx.db
DATABASE_BUSY_TIMEOUT_MS=5000
CACHE_TTL_SECONDS=604800
IDEMPOTENCY_TTL_SECONDS=86400
